#!/usr/bin/env python3
"""Folder Symbols: compose a symbolic icon onto a Yaru folder icon, reproducing Yaru's embossed style.

Thin wrapper around the folder_symbols package next to this file; the code lives there.
Run without arguments (or with --help) for the full description of every command and option.
Requires: python3, python3-pil, python3-numpy, python3-scipy, rsvg-convert (librsvg2-bin).
"""
import os, sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from folder_symbols import __version__  # noqa: F401  (the version lives in folder_symbols/__init__.py)
from folder_symbols.cli import main

if __name__ == "__main__":
    main(sys.argv[1:])
